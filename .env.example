# ==============================================================================
# HACKATHON STARTER — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local:
#      cp .env.example .env.local
# 2. Fill in ONLY the keys your hackathon project requires.
# 3. All provider keys are OPTIONAL at startup. The application will not crash if
#    unused keys are left blank.
# 4. NEVER commit .env.local or real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini (Google AI Studio)
# Dashboard: https://aistudio.google.com/
# Use for: Fast multimodal reasoning, long context window, general LLM tasks
# ------------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=

# ------------------------------------------------------------------------------
# OpenAI
# Dashboard: https://platform.openai.com/api-keys
# Use for: GPT-4o, reasoning models (o1/o3-mini), text embeddings, Whisper
# ------------------------------------------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Anthropic Claude
# Dashboard: https://console.anthropic.com/
# Use for: Claude 3.5 Sonnet / Haiku, nuanced reasoning, coding, analysis
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# Groq
# Dashboard: https://console.groq.com/
# Use for: Ultra-low latency Llama 3 / Mixtral inference, high token/sec speed
# ------------------------------------------------------------------------------
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# Hugging Face
# Dashboard: https://huggingface.co/settings/tokens
# Use for: Open-source models, custom inference endpoints, specialty vision/audio
# ------------------------------------------------------------------------------
HUGGINGFACE_API_KEY=

# ------------------------------------------------------------------------------
# Tavily Web Search
# Dashboard: https://app.tavily.com/
# Use for: Real-time search engine results optimized for LLM/RAG pipelines
# ------------------------------------------------------------------------------
TAVILY_API_KEY=

# ------------------------------------------------------------------------------
# Exa Neural Search
# Dashboard: https://dashboard.exa.ai/
# Use for: Semantic web search, neural link discovery, and webpage extraction
# ------------------------------------------------------------------------------
EXA_API_KEY=

# ------------------------------------------------------------------------------
# ElevenLabs
# Dashboard: https://elevenlabs.io/
# Use for: High-fidelity realistic text-to-speech, voice agents, sound effects
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# Supabase Project Configuration
# Dashboard: https://supabase.com/dashboard
# Use for: PostgreSQL database, user auth, storage buckets, vector search
# Note: Both NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY and NEXT_PUBLIC_SUPABASE_ANON_KEY
# are supported by this project's client helpers.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Server-side Supabase admin operations only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# Application Configuration (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Optional Integration Microservices (Part 4.1 Adapters)
# ------------------------------------------------------------------------------
# PaddleOCR HTTP Endpoint (e.g. http://localhost:8866/predict/ocr_system)
OCR_SERVICE_URL=

# Faster-Whisper ASR Endpoint (e.g. http://localhost:9000/asr)
WHISPER_SERVICE_URL=

# RAGFlow API Service & Key (e.g. http://localhost:9380)
RAGFLOW_SERVICE_URL=
RAGFLOW_API_KEY=

# Redis / BullMQ Connection URL (e.g. redis://localhost:6379)
REDIS_URL=

# Kokoro TTS Service Endpoint (e.g. http://localhost:8880)
KOKORO_SERVICE_URL=

# Piper TTS Service Endpoint (e.g. http://localhost:5000)
PIPER_SERVICE_URL=

# Tesseract OCR Service Endpoint (e.g. http://localhost:8080)
TESSERACT_SERVICE_URL=

# ------------------------------------------------------------------------------
# Database & Cache Persistence (Part 4.7)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection (e.g. postgresql://postgres:password@localhost:5432/mydb)
DATABASE_URL=

# Upstash Redis REST credentials (e.g. https://region.upstash.io)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# Payments & Webhook Infrastructure (Part 4.9)
# ------------------------------------------------------------------------------
# Stripe API Credentials (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Razorpay Credentials (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------------------
# Notifications & Messaging Infrastructure (Part 4.11)
# ------------------------------------------------------------------------------
# Resend Transactional Email (https://resend.com/api-keys)
RESEND_API_KEY=
EMAIL_FROM=

# Twilio SMS Credentials (Optional, https://console.twilio.com/)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------------------
# Observability & Error Reporting (Part 4.12)
# ------------------------------------------------------------------------------
# Log level: debug, info, warn, error (default: info in prod, debug in dev)
LOG_LEVEL=info

# Sentry DSN (Optional, https://sentry.io/)
SENTRY_DSN=

# ------------------------------------------------------------------------------
# Computer Vision & Video Processing Service (Part 4.14)
# ------------------------------------------------------------------------------
# Optional remote inference endpoint (Ultralytics YOLO, ONNX Runtime, MediaPipe)
VISION_SERVICE_URL=
VISION_API_KEY=

# ------------------------------------------------------------------------------
# Feature Flags & Runtime Configuration (Part 4.17)
# ------------------------------------------------------------------------------
# Runtime environment override: development, test, production
APP_ENV=development

# Feature flag overrides (format: FEATURE_FLAG_<NAME>=true/false or NEXT_PUBLIC_FLAG_<NAME>=true/false)
FEATURE_FLAG_EXPERIMENTAL_AI=false
NEXT_PUBLIC_FLAG_DARK_MODE=true
NEXT_PUBLIC_FLAG_BETA_DASHBOARD=false

# ------------------------------------------------------------------------------
# NEXSTORM Urban Flood Intelligence Configuration
# ------------------------------------------------------------------------------
# Secret key required for authorized verification/rejection of citizen observations
# (Never prefix with NEXT_PUBLIC_)
OBSERVATION_MODERATOR_KEY=

